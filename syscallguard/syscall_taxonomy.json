{
  "_metadata": {
    "version": "1.0",
    "description": "SyscallGuard Syscall Danger Tier Taxonomy",
    "author": "SyscallGuard Research Team",
    "last_updated": "2026-04-16",
    "classification_basis": "Based on Linux kernel syscall security analysis, MITRE ATT&CK techniques, and container escape research (Usenix Security, BlackHat, DEF CON publications)",
    "tiers": {
      "tier1": "CRITICAL — Syscalls enabling RCE, privilege escalation, container escape, or data exfiltration. Presence in a dependency that didn't previously use them is a strong supply chain attack indicator.",
      "tier2": "SUSPICIOUS — Syscalls for filesystem mutation, IPC, or resource manipulation. Unexpected additions may indicate tampering but could also reflect legitimate functionality changes.",
      "tier3": "BENIGN — Standard operational syscalls (memory management, time, file reading). Expected to appear in most applications."
    }
  },

  "tier1_critical": {
    "description": "Exploit-critical syscalls — strong anomaly signal if newly introduced by a dependency update",
    "syscalls": [
