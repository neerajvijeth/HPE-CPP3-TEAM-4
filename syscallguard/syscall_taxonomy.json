  "exploit_techniques": {
    "description": "Mapping of exploit technique categories to the syscalls they require. Used for blast radius containment scoring.",
    "techniques": {
      "remote_code_execution": {
        "required_syscalls": ["execve", "execveat", "clone", "clone3", "fork", "vfork"],
        "description": "Ability to spawn new processes or execute arbitrary binaries"
      },
      "privilege_escalation": {
        "required_syscalls": ["setuid", "setgid", "setreuid", "setregid", "setresuid", "setresgid", "setfsuid", "setfsgid"],
        "description": "Ability to change process identity"
      },
      "container_escape": {
        "required_syscalls": ["unshare", "setns", "pivot_root", "mount", "umount2"],
        "description": "Ability to manipulate namespaces and mount points"
      },
      "kernel_module_loading": {
        "required_syscalls": ["init_module", "finit_module", "delete_module"],
        "description": "Ability to load/unload kernel modules (rootkit vector)"
      },
      "process_injection": {
        "required_syscalls": ["ptrace", "process_vm_readv", "process_vm_writev"],
        "description": "Ability to inspect/modify other process memory"
      },
      "network_exfiltration": {
        "required_syscalls": ["socket", "connect", "bind", "listen", "accept", "accept4", "sendto", "recvfrom", "sendmsg", "recvmsg"],
        "description": "Ability to open network connections for data exfiltration"
      },
      "credential_theft": {
        "required_syscalls": ["keyctl", "request_key", "add_key"],
        "description": "Ability to access kernel keyring"
      },
      "ebpf_manipulation": {
        "required_syscalls": ["bpf", "perf_event_open"],
        "description": "Ability to load eBPF programs for traffic interception or rootkit behavior"
      },
      "memory_manipulation": {
        "required_syscalls": ["memfd_create", "userfaultfd", "shmget", "shmat"],
        "description": "Advanced memory manipulation for fileless malware or exploitation"
      },
      "system_disruption": {
        "required_syscalls": ["reboot", "kexec_load", "kexec_file_load"],
        "description": "Ability to reboot or replace running kernel"
      }
    }
  }
